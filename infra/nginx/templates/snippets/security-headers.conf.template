# TRD §15. Included in the server block AND in every location that sets its own add_header,
# because nginx drops inherited add_header directives as soon as a location adds one.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;
add_header X-Frame-Options "DENY" always;
add_header X-Request-ID $mms_request_id always;
add_header Content-Security-Policy "default-src 'self'; img-src 'self' https://${FILES_HOST} data: blob:; media-src 'self' https://${FILES_HOST} blob:; connect-src 'self' https://${FILES_HOST} wss://${MMS_HOST}; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'" always;
