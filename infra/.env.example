# Local development values. Copy to infra/.env (git-ignored). Staging and production use
# their own .env outside the repository, with every value regenerated (TRD §15).

MMS_HOST=mms.localhost
FILES_HOST=files.mms.localhost

# MongoDB: the root user is for mongo-init and backups only. One user per service database.
MONGO_ROOT_PASSWORD=dev-root-password
# Replica-set key file content (6-1024 base64 characters). Generate: openssl rand -base64 756
MONGO_KEYFILE=ZGV2LW9ubHkta2V5ZmlsZS1mb3ItdGhlLWxvY2FsLXN0YWNrLW5vdC1mb3Itc3RhZ2luZy1vci1wcm9kdWN0aW9u
AUTH_DB_PASSWORD=dev-auth-password
OPS_DB_PASSWORD=dev-ops-password
MEDIA_DB_PASSWORD=dev-media-password
REPORT_DB_PASSWORD=dev-report-password
PLATFORM_NOTIFICATION_DB_PASSWORD=dev-notification-password
PLATFORM_AUDIT_DB_PASSWORD=dev-audit-password

REDIS_PASSWORD=dev-redis-password

# Generate: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
# Each service's Kafka user (SASL/SCRAM, kafka/users.yml): 16 or more letters, digits, - or _.
# Generate: openssl rand -hex 24
KAFKA_AUTH_PASSWORD=dev-kafka-auth-password
KAFKA_OPERATIONS_PASSWORD=dev-kafka-operations-password
KAFKA_MEDIA_PASSWORD=dev-kafka-media-password
KAFKA_PLATFORM_PASSWORD=dev-kafka-platform-password
KAFKA_REPORT_PASSWORD=dev-kafka-report-password

# SeaweedFS S3 keys: one per service, limited to the buckets it needs; admin for operators.
MEDIA_S3_ACCESS_KEY=dev-media-access
MEDIA_S3_SECRET_KEY=dev-media-secret-not-for-production
REPORT_S3_ACCESS_KEY=dev-report-access
REPORT_S3_SECRET_KEY=dev-report-secret-not-for-production
ADMIN_S3_ACCESS_KEY=dev-admin-access
ADMIN_S3_SECRET_KEY=dev-admin-secret-not-for-production

# Host port for MongoDB in compose.dev.yml (127.0.0.1 only).
MONGO_DEV_PORT=27018

# Service-to-service secrets for auth's /internal/service-token (TRD §6.4). One per caller.
PLATFORM_SERVICE_SECRET=dev-platform-service-secret
OPS_SERVICE_SECRET=dev-operations-service-secret
MEDIA_SERVICE_SECRET=dev-media-service-secret
REPORT_SERVICE_SECRET=dev-report-service-secret

# Virus scan on uploaded files (PRD MED-3): clamd streams every file to ClamAV, off skips it.
# `off` is for hosts too small for ClamAV (staging, TRD T8); production refuses to start with
# it. For clamd, add `--profile scan` to compose so the clamav container runs.
MEDIA_SCAN_MODE=off

# Account emails from platform (NOT-3). Locally they go to Mailpit (http://127.0.0.1:8025).
# Staging and production: the organization's SMTP relay (T3), with starttls or ssl.
PLATFORM_MAIL_FROM=MARS-MMS <no-reply@mms.localhost>
PLATFORM_SMTP_HOST=mailpit
PLATFORM_SMTP_PORT=1025
PLATFORM_SMTP_SECURITY=none
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=

# Breached-password check (AUTH-9, T1): hibp (default), file, or off.
AUTH_BREACHED_CHECK=hibp

# Password for the seed users made by `docker compose exec auth python -m app.cli seed`.
AUTH_SEED_PASSWORD=dev-seed-password-1

# Monitoring (compose.monitoring.yml, W20-2): the exporters' users, Grafana and the alert mail.
# Without MONITOR_DB_PASSWORD and KAFKA_MONITOR_PASSWORD those users are not created.
MONITOR_DB_PASSWORD=dev-monitor-password
KAFKA_MONITOR_PASSWORD=dev-kafka-monitor-password
GRAFANA_ADMIN_PASSWORD=dev-grafana-password
# Admin addresses that receive alerts, separated by commas. The relay is the platform's unless
# ALERT_SMTP_HOST, ALERT_SMTP_PORT, ALERT_FROM, ALERT_SMTP_USERNAME or ALERT_SMTP_PASSWORD is set.
MMS_ALERT_EMAILS=admin@example.org
ALERT_GROUP_WAIT=5s
# Docker Desktop cannot bind the root with `rslave`; leave this empty locally, unset on a Linux host.
NODE_EXPORTER_ROOT_FLAGS=

# Backups (compose.backup.yml, W20-6): the dump user, and the PUBLIC key backups are encrypted to.
# Make a pair with `age-keygen`; keep the private key off every host the stack runs on. Locally
# the backup container refuses to start without a key: run the tests, which make their own.
BACKUP_DB_PASSWORD=dev-backup-password
BACKUP_AGE_RECIPIENT=
# Where copies go: an rclone path. Locally a folder in the container; a real backup host is
# BACKUP_REMOTE=backup:/srv/mms-backups with RCLONE_CONFIG_BACKUP_TYPE=sftp and its _HOST/_USER/_KEY_FILE.
BACKUP_REMOTE=:local:/backups
# SeaweedFS replica (compose.backup-host.yml locally): the endpoint `backup` compares with.
BACKUP_REPLICA_S3_ENDPOINT=http://seaweedfs-replica:8333
