# Secrets and local environment. Commit only *.example files.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node (frontend/.gitignore covers its own build output)
node_modules/

# Test output
playwright-report/
test-results/

# Local data from Compose volumes bound into the repo
infra/data/
# Earlier releases' assets for the web image, made in CI (infra/scripts/carry_assets.py)
infra/nginx/carry/

# Logo sources: only the PNGs that `npm run brand` reads are committed (DBD D1)
logo/*.psd
logo/watermarked_*

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# Claude Code: personal settings stay local; project skills are committed
.claude/settings.local.json

# Local self-signed certificates (infra/nginx/dev-certs.sh)
infra/nginx/certs/
