        "additionalProperties": false,
        "properties": {
          "contact_phone": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Printed on every label. Empty uses the organization's default.",
            "title": "Contact Phone"
          },
          "station_ids": {
            "items": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Station Ids",
            "type": "array"
          }
        },
