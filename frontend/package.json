{
  "name": "aws-mms-frontend",
  "private": true,
  "type": "module",
  "version": "0.5.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:kill": "vite build --mode kill --outDir dist-kill",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript openapi/auth.json -o src/api/types/auth.ts && openapi-typescript openapi/operations.json -o src/api/types/operations.ts && openapi-typescript openapi/media.json -o src/api/types/media.ts && openapi-typescript openapi/report.json -o src/api/types/report.ts && openapi-typescript openapi/platform.json -o src/api/types/platform.ts",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/js": "^7.4.47",
    "@noble/hashes": "1.8.0",
    "dexie": "^4.4.6",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pdfjs-dist": "6.4.299",
    "pinia": "^3.0.4",
    "pmtiles": "3.2.1",
    "protomaps-leaflet": "5.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "sass-embedded": "^1.98.0",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
