FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv

# Build context is the repository root (compose passes `context: ..`) so mms_common is available.
COPY libs/mms_common /srv/libs/mms_common
RUN pip install /srv/libs/mms_common

COPY services/{{ service_name }}/pyproject.toml /srv/services/{{ service_name }}/pyproject.toml
COPY services/{{ service_name }}/app /srv/services/{{ service_name }}/app
RUN pip install /srv/services/{{ service_name }}

RUN useradd --system --uid 10001 mms
USER mms
WORKDIR /srv/services/{{ service_name }}
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
